{
  "version": 8,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 30,
    "patch": 0
  },
  "include": ["util/CMakeConfigurePresets.json"],
  "configurePresets": [
    {
      "name": "conf-gcc-dev",
      "inherits": [
        "conf-default",
        "conf-dev",
        "conf-gcc",
        "conf-sanitizer-basic"
      ]
    },
    {
      "name": "conf-clang-dev",
      "inherits": [
        "conf-default",
        "conf-dev",
        "conf-clang",
        "conf-sanitizer-basic"
      ]
    }
  ],
  "buildPresets": [
    {
      "name": "build-gcc-dev",
      "configurePreset": "conf-gcc-dev",
      "verbose": true
    },
    {
      "name": "build-clang-dev",
      "configurePreset": "conf-clang-dev",
      "verbose": true
    }
  ],
  "testPresets": [
    {
      "name": "test-gcc-dev",
      "inherits": "test-default",
      "configurePreset": "conf-gcc-dev"
    },
    {
      "name": "test-clang-dev",
      "inherits": "test-default",
      "configurePreset": "conf-clang-dev"
    }
  ],
  "workflowPresets": [
    {
      "name": "work-gcc-dev",
      "steps": [
        {
          "type": "configure",
          "name": "conf-gcc-dev"
        },
        {
          "type": "build",
          "name": "build-gcc-dev"
        },
        {
          "type": "test",
          "name": "test-gcc-dev"
        }
      ]
    },
    {
      "name": "work-clang-dev",
      "steps": [
        {
          "type": "configure",
          "name": "conf-clang-dev"
        },
        {
          "type": "build",
          "name": "build-clang-dev"
        },
        {
          "type": "test",
          "name": "test-clang-dev"
        }
      ]
    }
  ]
}
