{
  "version": 8,
  "configurePresets": [
    {
      "name": "conf-default",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "generator": "Ninja",
      "warnings": {
        "dev": false,
        "deprecated": true,
        "uninitialized": true,
        "unusedCli": true,
        "systemVars": true
      },
      "hidden": true
    },
    {
      "name": "conf-windows-base",
      "hidden": true,
      "inherits": "conf-default",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "conf-unix-base",
      "hidden": true,
      "inherits": "conf-default",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "conf-debug",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "conf-release",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "conf-dev",
      "hidden": true,
      "inherits": "conf-debug",
      "cacheVariables": {
        "PROJECT_DEV_BUILD": "ON"
      }
    },
    {
      "name": "conf-sanitizer-basic",
      "hidden": true,
      "cacheVariables": {
        "PROJECT_SANITIZER_ADDRESS_ENABLED": true,
        "PROJECT_SANITIZER_UNDEFINED_ENABLED": true
      }
    },
    {
      "name": "conf-gcc",
      "hidden": true,
      "cacheVariables": {
         "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "conf-clang",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "conf-development",
      "hidden": true,
      "inherits": [
        "conf-dev",
        "conf-sanitizer-basic"
      ]
    },
    {
      "name":"conf-sanitizer-thread",
      "hidden":true,
      "inherits":[
        "conf-dev"
      ],
      "cacheVariables": {
        "PROJECT_SANITIZER_THREAD_ENABLED": true
      }
    }
  ],
  "testPresets": [
    {
      "name": "test-default",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}